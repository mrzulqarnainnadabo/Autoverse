# AUTOVERSE Mobile — Environment Variables
# Copy to .env and fill in your own values. Expo only exposes vars
# prefixed EXPO_PUBLIC_ to the app bundle — do not put secrets here,
# only values that are safe to ship on-device (this is why the mobile
# app uses the Supabase ANON key, never the service role key).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Live Autoverse backend on Vercel (auto-deploys from main)
EXPO_PUBLIC_API_BASE_URL=https://autoverse-backend.vercel.app
